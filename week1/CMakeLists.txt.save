cmake_minimum_required(VERSION 3.20)
project(QuantumLite)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# OpenSSL (Homebrew keg-only)
set(OPENSSL_ROOT_DIR "/opt/homebrew/opt/openssl@3")
set(OPENSSL_INCLUDE_DIR "/opt/homebrew/opt/openssl@3/include")
set(OPENSSL_CRYPTO_LIBRARY "/opt/homebrew/opt/openssl@3/lib/libcrypto.dylib")

find_library(OQS_LIB oqs REQUIRED
    PATHS /opt/homebrew/lib /usr/local/lib
)
find_path(OQS_INCLUDE oqs/oqs.h
    PATHS /opt/homebrew/include /usr/local/include
)

include_directories(${OQS_INCLUDE} ${OPENSSL_INCLUDE_DIR})

add_executable(kyber_hello src/kyber_hello.cpp)
target_link_libraries(kyber_hello ${OQS_LIB} ${OPENSSL_C
